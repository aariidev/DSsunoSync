<Window x:Class="ArideevSunoPresence.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="aarideev | SunoSync" Icon="pack://application:,,,/Assets/Arideev.png" Height="760" Width="1180"
 MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen"
 Background="#0B0D12" Foreground="#F4F4F6">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="30,22,30,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="54" Height="54" Background="#171920" BorderBrush="#2A2D35" BorderThickness="1" CornerRadius="13" Padding="5">
    <Image Source="pack://application:,,,/Assets/Arideev.png" Stretch="Uniform"/>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
    <TextBlock Text="aarideev  |" FontSize="11" Foreground="#E55A6B" FontWeight="Bold"/>
    <TextBlock Text="SunoSync" FontSize="23" FontWeight="SemiBold" Margin="0,2,0,0"/>
   </StackPanel>
   <Border Grid.Column="2" Background="#171920" BorderBrush="#2A2D35" BorderThickness="1" CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#E3A23B" Margin="0,0,9,0"/>
     <TextBlock x:Name="ConnectionText" Text="Iniciando conector..." Foreground="#D4D5DA" FontSize="12"/>
    </StackPanel>
   </Border>
  </Grid>
  <Grid Grid.Row="1" Margin="30,0,30,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <Border Background="#14161C" BorderBrush="#282B33" BorderThickness="1" CornerRadius="18" Padding="24">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,16">
      <TextBlock Text="REPRODUCIENDO AHORA" Foreground="#A4A7B0" FontSize="10" FontWeight="Bold"/>
      <TextBlock x:Name="SourceText" Text="SIN FUENTE" Foreground="#777B86" FontSize="10" DockPanel.Dock="Right"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#20232B" CornerRadius="13" ClipToBounds="True">
      <Grid>
       <TextBlock Text="♫" FontSize="72" Foreground="#E45566" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
       <Border VerticalAlignment="Bottom" Height="90">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#A9000000" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
      </Grid>
     </Border>
     <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="TrackTitle" Text="Esperando una canción..." FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="TrackArtist" Text="Abre Suno en Brave, Chrome o Edge" Foreground="#A4A7B0" Margin="0,6,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#28171B" CornerRadius="7" Padding="9,5" VerticalAlignment="Center">
       <TextBlock Text="SUNO" Foreground="#EF7180" FontSize="10" FontWeight="Bold"/>
      </Border>
     </Grid>
     <StackPanel Grid.Row="3" Margin="0,24,0,0">
      <ProgressBar x:Name="TrackProgress" Height="4" Maximum="100" Value="0" Background="#30333B" Foreground="#E34A5E"/>
      <DockPanel Margin="0,9,0,0">
       <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="#A4A7B0" FontSize="11"/>
       <TextBlock x:Name="DurationText" Text="--:--" Foreground="#A4A7B0" FontSize="11" DockPanel.Dock="Right"/>
      </DockPanel>
     </StackPanel>
     <Border Grid.Row="5" Background="#1B1E25" BorderBrush="#2B2E37" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal">
       <Ellipse x:Name="PlaybackDot" Width="8" Height="8" Fill="#777B86" Margin="0,0,9,0"/>
       <TextBlock x:Name="PlaybackText" Text="Sin reproducción detectada" Foreground="#C3C5CB" FontSize="12"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="#14161C" BorderBrush="#282B33" BorderThickness="1" CornerRadius="18" Padding="22">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="CONFIGURACIÓN" Foreground="#E55A6B" FontSize="10" FontWeight="Bold" Margin="0,0,0,18"/>
      <TextBlock Text="Discord Application ID" Foreground="#E4E5E8" FontSize="12" FontWeight="SemiBold"/>
      <TextBox x:Name="ClientIdBox" Margin="0,8,0,7" Padding="11,9" Background="#1D2027" Foreground="White" BorderBrush="#353842" CaretBrush="White"/>
      <TextBlock Text="Usa el Application ID de tu aplicación en Discord Developer Portal." TextWrapping="Wrap" Foreground="#898D97" FontSize="11" Margin="0,0,0,16"/>
      <CheckBox x:Name="PresenceEnabled" Content="Activar Rich Presence" IsChecked="True" Foreground="#E4E5E8" Margin="0,0,0,13"/>
      <CheckBox x:Name="StartWithWindows" Content="Iniciar con Windows (en la bandeja)" IsChecked="False" Foreground="#E4E5E8" Margin="0,0,0,16"/>
      <Button x:Name="SaveButton" Content="Guardar configuración" Click="SaveButton_Click" Background="#D9364F" Foreground="White"/>
      <Button Content="Probar conexión con Discord" Click="TestDiscord_Click" Margin="0,9,0,0" Background="#292C34" Foreground="#F0F0F2"/>
      <Grid Margin="0,9,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="Discord Developer" Click="OpenDiscordDeveloper_Click" Background="#20232A" Foreground="#D4D5DA" FontSize="11"/>
       <Button Grid.Column="2" Content="Abrir Suno" Click="OpenSuno_Click" Background="#20232A" Foreground="#D4D5DA" FontSize="11"/>
      </Grid>
      <Button Content="Abrir extensión Brave / Chrome / Edge" Click="OpenExtensionPage_Click" Margin="0,9,0,0" Background="#20232A" Foreground="#D4D5DA" FontSize="11"/>
      <Border Background="#1B1E25" BorderBrush="#2B2E37" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,20,0,0">
       <StackPanel>
        <TextBlock Text="ESTADO DEL SISTEMA" Foreground="#E55A6B" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock x:Name="BrowserStatus" Text="Navegador: esperando el primer mensaje de la extensión" TextWrapping="Wrap" Foreground="#D4D5DA" FontSize="11" Margin="0,3"/>
        <TextBlock x:Name="BrowserDiagnostics" Text="Diagnóstico: todavía no hay datos del navegador." TextWrapping="Wrap" Foreground="#9296A0" FontSize="10" Margin="0,3"/>
        <TextBlock x:Name="DiscordStatus" Text="Discord: pendiente de prueba" TextWrapping="Wrap" Foreground="#D4D5DA" FontSize="11" Margin="0,3"/>
        <TextBlock x:Name="UpdateStatus" Text="Actualizaciones: comprobando..." TextWrapping="Wrap" Foreground="#9296A0" FontSize="10" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Text="Cerrar la ventana la mantiene activa en la bandeja." TextWrapping="Wrap" Foreground="#777B86" FontSize="10" Margin="2,12,2,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="30,0,30,13">
   <TextBlock Text="aarideev  /  SUNOSYNC  /  0.3.6" Foreground="#666A73" FontSize="10"/>
   <TextBlock x:Name="LogText" Text="Preparado." Foreground="#9296A0" FontSize="10" DockPanel.Dock="Right"/>
  </DockPanel>
 </Grid>
</Window>
