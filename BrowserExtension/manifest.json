{
  "manifest_version": 3,
  "name": "aarideev | SunoSync Connector",
  "version": "0.3.1",
  "description": "Conecta el reproductor de Suno con aarideev | SunoSync.",
  "permissions": [],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*",
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://*.suno.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://suno.com/*",
        "https://*.suno.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Conectar aarideev | SunoSync",
    "default_popup": "popup.html"
  }
}
